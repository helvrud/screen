# Environment variables for Docker development (SQLite Mode)
# Copy this file to .env and customize as needed

# Django settings
DJANGO_SETTINGS_MODULE=physchem.settings
DEBUG=True
SECRET_KEY=docker-dev-secret-key-change-in-production

# Database configuration (SQLite is default)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Optional: Auto-create superuser on first run
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@physchem.cz
# DJANGO_SUPERUSER_PASSWORD=admin123
